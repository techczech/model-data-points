---
import BaseLayout from '../layouts/BaseLayout.astro';
import {getEntries,entryHTML,NAME} from '../lib/content';
export function getStaticPaths(){return getEntries().map(entry=>({params:{slug:entry.slug},props:{entry}}));}
const {entry}=Astro.props;
---
<BaseLayout title={`${entry.title} · ${NAME}`} description={entry.headline} entry={entry} cite><main id="main" class="wrap entry" style="padding-top:2.5rem"><Fragment set:html={entryHTML(entry)} /></main></BaseLayout>
